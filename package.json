{
  "name": "ailog",
  "private": true,
  "scripts": {
    "dev": "./scripts/dev.sh",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "api:dev": "DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/ailog ./.venv/bin/uvicorn app.main:app --app-dir apps/api --host 127.0.0.1 --port 8000 --reload",
    "api:dev:sqlite": "DATABASE_URL=sqlite:///./ailog.db ./.venv/bin/uvicorn app.main:app --app-dir apps/api --host 127.0.0.1 --port 8000 --reload",
    "db:up": "./scripts/db.sh up",
    "db:down": "./scripts/db.sh down",
    "db:logs": "./scripts/db.sh logs",
    "test:api": "cd apps/api && ../../.venv/bin/python -m pytest"
  }
}
